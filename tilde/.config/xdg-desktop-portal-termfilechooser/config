### https://github.com/hunkyburrito/xdg-desktop-portal-termfilechooser
### Enabled in nixen: modules/system/desktop.nix (xdg.portal.config.niri).
### Firefox/Zen needs widget.use-xdg-desktop-portal.file-picker=1

[filechooser]
# stock wrapper from the nixpkgs package — its dir is in the binary's search path
cmd=yazi-wrapper.sh
default_dir=/home/lmnk/Downloads
create_help_file=0
# -e must stay last: TERMCMD is prefixed to the yazi command
env=TERMCMD=ghostty --class=com.lmnk.termfilechooser --title=termfilechooser -e
open_mode=suggested
save_mode=last
